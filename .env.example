# =============================================================================
# IVAN MEDIA — PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env y ajusta los valores correspondientes
# =============================================================================

# Configuración General del Sitio
APP_NAME=
APP_ENV=
APP_DEBUG=
APP_URL=
SITE_EYEBROW=
SITE_DESCRIPTION=

# -----------------------------------------------------------------------------
# Cloudinary (opcional para subida automatizada de imágenes)
# -----------------------------------------------------------------------------
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=dbs1ypch
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Información de Contacto Principal
# -----------------------------------------------------------------------------
CONTACT_EMAIL
CONTACT_PHONE
CONTACT_PHONE_FORMATTED
CONTACT_WHATSAPP
CONTACT_INSTAGRAM
CONTACT_FACEBOOK
CONTACT_X
CONTACT_LINKEDIN
CONTACT_LOCATION
CONTACT_SCHEDULE

# -----------------------------------------------------------------------------
# Compatibilidad Directa
# -----------------------------------------------------------------------------
EMAIL
TELEFONO
WHATSAPP
Whatsapp
INSTAGRAM

# -----------------------------------------------------------------------------
# Configuración SMTP para Envío de Cotizaciones en PDF (Titan Email)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_USER=noreply@gaserviciodistribuciones.com.mx
EMAIL_PWD=
EMAIL_ENCRYPTION=ssl
EMAIL_FROM_ADDRESS=noreply@ivanmedia.com.mx
EMAIL_FROM_NAME="Ivan Media"

# Destinatario de cotizaciones (Pruebas)
QUOTE_RECIPIENT_EMAIL=luisagalazmp@gmail.com
QUOTE_RECIPIENT_NAME="Ivan Media Cotizaciones"
